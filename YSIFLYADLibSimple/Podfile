# 本示例固定使用 6.5.5-beta.1；请运行 pod install 生成锁文件。安装与运行需在宿主 App 中验证。
# 历史 Tag、Release 和资产保持不可变。

source 'https://cdn.cocoapods.org/'
platform :ios, '11.0'



target 'YSIFLYADLibSimple' do
  use_frameworks!
  # CocoaPods 固定使用 6.5.4，自动添加资源包和 -ObjC。
  # 静态 XCFramework 随 App 链接，无需 Embed。
  pod 'YSIFLYADLib', :podspec => 'https://raw.githubusercontent.com/LJMcarryu/YSIFLYADLib_iOS/6.5.5-beta.1/YSIFLYADLib.podspec'
end
