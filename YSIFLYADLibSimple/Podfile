source 'https://cdn.cocoapods.org/'
platform :ios, '11.0'

target 'YSIFLYADLibSimple' do
  use_frameworks!
  # 固定使用 6.3.5；CocoaPods 自动添加资源包和 -ObjC。
  # 静态 XCFramework 随 App 链接，无需 Embed。
  pod 'YSIFLYADLib', :podspec => 'https://raw.githubusercontent.com/LJMcarryu/YSIFLYADLib_iOS/6.3.5/YSIFLYADLib.podspec'
end
