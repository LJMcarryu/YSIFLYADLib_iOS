# 本示例固定使用 6.5.1；请运行 pod install 生成锁文件。安装与运行需在宿主 App 中验证。
# 历史 Tag、Release 和资产保持不可变。

source 'https://cdn.cocoapods.org/'
platform :ios, '11.0'


# 历史版本 6.5.0 继承 6.4.0，公开 API 方法签名不变。UIScene 展示、落地页、外跳回流、曝光和 UI 生命周期绑定实际来源 window/Scene；
# 无来源时只允许唯一且明确的前台应用 Scene，不跨 Scene 随机兜底，独立落地页始终属于来源 Scene。
# 开屏 rootVC 仍须入窗；Scene 宿主的 customWindow 须可见、尺寸有限且为正、已关联且与 rootVC.window 同 Scene，
# 可为非 key、高 windowLevel、无 rootVC；非法输入展示失败，修正后可重试。历史 Tag、Release 和资产保持不变。

target 'YSIFLYADLibSimple' do
  use_frameworks!
  # CocoaPods 固定使用 6.5.1，自动添加资源包和 -ObjC。
  # 静态 XCFramework 随 App 链接，无需 Embed。
  pod 'YSIFLYADLib', '6.5.1'
end
