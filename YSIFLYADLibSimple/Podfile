source 'https://cdn.cocoapods.org/'
platform :ios, '11.0'

target 'YSIFLYADLibSimple' do
  use_frameworks!
  # YS 媒体定制 SDK（model B 单包静态 framework：开屏/Banner/插屏/信息流，含视频，无激励）。
  # 二进制托管在本仓 GitHub Releases，podspec 经 raw URL 直连；静态库随 app 链接（无需 Embed），
  # 资源包 YSAdvSDK.bundle 经 podspec s.resources 自动拷入 app，-ObjC 由 podspec 自动注入。
  # 6.2.4 发布准备；候选与正式验证均固定到同版本 tag 和 Release 资产。
  pod 'YSIFLYADLib', :podspec => 'https://raw.githubusercontent.com/LJMcarryu/YSIFLYADLib_iOS/6.2.4/YSIFLYADLib.podspec'
end
