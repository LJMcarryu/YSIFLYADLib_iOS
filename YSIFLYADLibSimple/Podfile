source 'https://cdn.cocoapods.org/'
platform :ios, '11.0'

# 6.3.6 当前仅为待联调候选，尚未发布；示例继续使用公开正式版 6.3.5。
# 候选公开 API 方法签名不变。UIScene 展示、落地页、外跳回流、曝光和 UI 生命周期绑定实际来源 window/Scene；
# 无来源时只允许唯一且明确的前台应用 Scene，不跨 Scene 随机兜底，独立落地页始终属于来源 Scene。
# 开屏 rootVC 仍须入窗；Scene 宿主的 customWindow 须可见、尺寸有限且为正、已关联且与 rootVC.window 同 Scene，
# 可为非 key、高 windowLevel、无 rootVC；非法输入展示失败，修正后可重试。历史 Tag、Release 和资产保持不变。

target 'YSIFLYADLibSimple' do
  use_frameworks!
  # 固定使用 6.3.5；CocoaPods 自动添加资源包和 -ObjC。
  # 静态 XCFramework 随 App 链接，无需 Embed。
  pod 'YSIFLYADLib', :podspec => 'https://raw.githubusercontent.com/LJMcarryu/YSIFLYADLib_iOS/6.3.5/YSIFLYADLib.podspec'
end
